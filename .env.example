DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=0.1.0
COMPOSE_PROJECT_NAME=devops-course
NGINX_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
UID=1000
GID=1000

# Активное окружение конфига (dev | prod | ...) — файл app/config/{APP_ENV}.php
APP_ENV=dev
# Ключ шифрования секретов конфига, ровно 32 байта. Сгенерировать:
#   php -r "echo bin2hex(random_bytes(16));"
# ВНИМАНИЕ: реальный ключ сюда не пишите — он хранится только в .gitignore-файле .env
APP_CIPHER_KEY=changeme_changeme_changeme_chang
